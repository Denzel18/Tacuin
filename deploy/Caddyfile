# Caddy: HTTPS automatico (Let's Encrypt) davanti a Tacuìn.
# Il dominio principale arriva dalla variabile DOMAIN del file .env (es. tacuin.tuodominio.it).
# Altri indirizzi si aggiungono da Tacuìn (Impostazioni → Server → Dominio): Caddy crea il loro certificato
# al primo accesso, ma solo dopo aver chiesto a Tacuìn se quel dominio è autorizzato (niente certificati per domini altrui).
{
	on_demand_tls {
		ask http://tracker:8080/api/caddy/ask
	}
	# contro chi apre connessioni e manda i dati a goccia (slowloris) o intestazioni enormi
	servers {
		timeouts {
			read_header 10s
			read_body 2m
			write 2m
			idle 2m
		}
		max_header_size 32KB
	}
}

(tacuin) {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(self), microphone=(), geolocation=(self), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
		-X-Powered-By
	}

	# foto degli scontrini e file .FIT: fino a 25 MB
	request_body {
		max_size 25MB
	}

	# Caddy passa già X-Forwarded-For e X-Forwarded-Proto: Tacuìn vede IP reale e HTTPS
	# metodi che l'app non usa: fermati qui, non arrivano nemmeno a Tacuìn
	@strani not method GET POST
	respond @strani 405

	reverse_proxy tracker:8080 {
		# se Tacuìn è sovraccarico, meglio una risposta veloce che code infinite
		transport http {
			dial_timeout 5s
			response_header_timeout 60s
		}
	}
}

{$DOMAIN} {
	import tacuin
}

# indirizzi aggiunti dall'interfaccia
https:// {
	tls {
		on_demand
	}
	import tacuin
}
