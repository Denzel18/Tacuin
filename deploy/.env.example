# Copia in ".env" (cp .env.example .env) e compila. Questo file NON va mai su GitHub.

# ---------- Come si raggiunge da fuori
# https  = VPS con IP pubblico (Caddy, porte 80/443)
# tunnel = Cloudflare Tunnel (casa, Raspberry, o VPS senza porte aperte)
COMPOSE_PROFILES=https
# Indirizzo pubblico, senza https:// (il record DNS A deve puntare all'IP del server, oppure lo crea il tunnel)
DOMAIN=tracker.miodominio.it
# Solo per il profilo tunnel: il token che Cloudflare mostra quando crei il tunnel
TUNNEL_TOKEN=

# Versione delle immagini (latest, oppure il codice del commit es. sha-ffd56d5)
TAG=latest
TZ=Europe/Rome

# ---------- Account root (creato al primo avvio)
ROOT_EMAIL=
ROOT_PASSWORD=
ROOT_NAME=


# ---------- Email: esempio Brevo (gratis fino a 300 email al giorno)
# SMTP_USER e SMTP_PASSWORD si trovano in Brevo → SMTP & API → SMTP. Il mittente va verificato.
# Con una casella Aruba: SMTP_HOST=smtps.aruba.it, SMTP_PORT=465, SMTP_SECURITY=ssl,
# SMTP_USER e SMTP_FROM = l'indirizzo della casella, SMTP_PASSWORD = la sua password.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
# Indirizzo «di sistema» (registrazioni, promemoria, link per la password). Deve essere di un dominio TUO,
# verificato sul servizio email (SPF/DKIM), es. noreply@tuodominio.it: con un dominio non tuo le mail vengono rifiutate.
# Facoltativo: chi riceve i messaggi «Scrivi all'amministratore» della pagina di accesso
# (vuoto = l'indirizzo scelto dal root in Impostazioni, altrimenti l'email del root). Non è mai mostrato agli utenti.
CONTACT_EMAIL=
# Gli inviti agli appuntamenti partono da qui come «Mario Rossi via Tacuìn», con Rispondi-a sull'email di chi invita.
SMTP_FROM=noreply@tuodominio.it
SMTP_FROM_NAME=Tacuìn

# ---------- Scontrini da foto (servizio "vision", avviato da docker compose insieme a Tacuìn)
# Valore standard: non cambiarlo se usi deploy.sh / docker compose.
VISION_URL=http://vision:8090
# Chiave interna tra Tacuìn e il servizio scontrini: se è vuota la crea setup.sh (o deploy.sh)
VISION_TOKEN=

# ---------- Backup fuori dal server (facoltativo ma consigliato), usati da backup.sh
# Dove copiare gli archivi via rsync/ssh, es. Storage Box Hetzner: u123456@u123456.your-storagebox.de:tracker
BACKUP_REMOTE=
BACKUP_SSH_PORT=23
# Oppure (o in più) su S3: AWS o compatibili. Su AWS: bucket privato + utente IAM con il solo permesso
# di scrivere i backup (vedi aws-s3-backup-policy.json). Ogni notte un archivio in <prefisso>/backup/.
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=eu-central-1
BACKUP_S3_PREFIX=tracker
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# Solo per servizi non AWS (es. https://<account>.r2.cloudflarestorage.com); su AWS lascialo vuoto
BACKUP_S3_ENDPOINT=
# Oppure su Google Cloud Storage, dalla VM di Google: nessuna chiave, usa l'identità della VM
# (la crea deploy/gcp con Terraform, con il solo permesso di scrivere nel bucket).
BACKUP_GCS_BUCKET=
BACKUP_GCS_PREFIX=tracker
# Se impostata, gli archivi vengono cifrati (AES-256) prima di uscire dal server. NON perderla.
BACKUP_PASSPHRASE=
# Quanti archivi tenere sul server
BACKUP_KEEP=14

# ---------- Conservazione
# Giorni di conservazione del registro attività (accessi e operazioni sugli account). Predefinito 365 = 12 mesi.
AUDIT_RETENTION_DAYS=365
# Giorni di conservazione degli inviti dopo la data dell'appuntamento. Predefinito 365 = 12 mesi.
INVITE_RETENTION_DAYS=365

# ---------- Titolare per l'informativa privacy (pagine pubbliche /privacy e /condizioni)
# Facoltativo: se vuoti valgono quelli inseriti dal root in Impostazioni → Dati del titolare.
PRIVACY_OWNER=
PRIVACY_ADDRESS=
PRIVACY_EMAIL=

# Tetto di inviti via email al giorno per tutto il server (contro lo spam)
# INVITES_SERVER_PER_DAY=400

# Licenza AGPL-3.0: link al codice sorgente mostrato in fondo a ogni pagina.
# Se hai modificato Tacuìn, metti qui il link alla tua versione (es. il tuo fork su GitHub).
# SOURCE_URL=https://github.com/Denzel18/tacuin
