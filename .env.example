# Copia questo file in ".env" e compila i valori.

# ---------- Account amministratore (root)
# Al primo avvio puoi creare il root dalla pagina web aprendola da questo PC (http://localhost:8080).
# In alternativa (obbligatorio in Docker/cloud) indicalo qui: viene creato al primo avvio.
ROOT_EMAIL=
ROOT_PASSWORD=
ROOT_NAME=


# ---------- Email (promemoria, avvisi agli admin, approvazioni, link password)
# Esempio Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=tuoindirizzo@gmail.com,
# SMTP_PASSWORD=la "password per le app" di 16 lettere (non la password normale), vedi README.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Mittente (se vuoto usa SMTP_USER) e nome visualizzato
# Indirizzo «di sistema» (registrazioni, promemoria, link per la password). Deve essere di un dominio TUO,
# verificato sul servizio email (SPF/DKIM), es. noreply@tuodominio.it: con un dominio non tuo le mail vengono rifiutate.
# Gli inviti agli appuntamenti partono da qui come «Mario Rossi via Tacuìn», con Rispondi-a sull'email di chi invita.
SMTP_FROM=noreply@tuodominio.it
SMTP_FROM_NAME=Tacuìn
# starttls (porta 587, predefinito) · ssl (porta 465) · none (solo test)
SMTP_SECURITY=

# ---------- Scontrini da foto (servizio "vision", vedi README)
# Valore standard: il servizio sullo stesso PC (lo avvia «Avvia per test.bat» / tools/avvio_test.py).
VISION_URL=http://localhost:8090
# Facoltativo: chiave condivisa tra tracker e vision (stessa nei due servizi)
VISION_TOKEN=

# ---------- Rete
# Porta della web app (http://localhost:8080)
PORT=8080
# 127.0.0.1 = raggiungibile solo da questo PC; 0.0.0.0 = anche dagli altri dispositivi di casa.
# In Docker/cloud viene impostato automaticamente a 0.0.0.0.
HOST=127.0.0.1
# Indirizzo pubblico (es. https://tracker.miodominio.it), usato nei link inviati agli utenti
PUBLIC_URL=
# Metti 1 se il tracker è dietro HTTPS (reverse proxy): i cookie di accesso diventano "Secure"
COOKIE_SECURE=
# Metti 1 se c'è un reverse proxy davanti (per leggere l'IP reale dei visitatori nel registro)
TRUST_PROXY=

# ---------- Standby
# Mentre il tracker è acceso il PC non va in standby da solo (lo schermo si spegne comunque).
# Metti 0 per permettere lo standby come al solito.
KEEP_AWAKE=1

# ---------- Solo se il bot dà errori di certificato HTTPS
# percorso del certificato esportato dall'antivirus (vedi README)
# SSL_CA_FILE=C:\Users\nome\tracker-server\antivirus.cer

# ---------- Avvio per i test ("Avvia per test.bat" / tools/avvio_test.py) — tutto facoltativo
# Cartella dei log delle sessioni di test (predefinita: logs nella cartella del progetto)
TEST_LOG_DIR=
# Giorni dopo cui le cartelle di sessione già archiviate vengono cancellate (lo .zip resta). 0 = mai
TEST_KEEP_DAYS=30
# 0 = non aprire il browser all'avvio
TEST_OPEN_BROWSER=1

# ---------- Archivio delle sessioni: local (cartella) oppure s3 (AWS, MinIO, Cloudflare R2, Backblaze B2...)
ARCHIVE_BACKEND=local
# Solo per local: dove copiare gli .zip (predefinita: logs/archivio)
ARCHIVE_DIR=
# Solo per s3
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_PREFIX=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---------- Conservazione
# Giorni di conservazione del registro attività (accessi e operazioni sugli account). Predefinito 365 = 12 mesi.
AUDIT_RETENTION_DAYS=365
# Giorni di conservazione degli inviti dopo la data dell'appuntamento. Predefinito 365 = 12 mesi.
INVITE_RETENTION_DAYS=365

# ---------- Titolare per l'informativa privacy (pagine pubbliche /privacy e /condizioni)
# Facoltativo: se vuoti valgono quelli inseriti dal root in Impostazioni → Dati del titolare.
PRIVACY_OWNER=
PRIVACY_ADDRESS=
PRIVACY_EMAIL=

# Tetto di inviti via email al giorno per tutto il server (contro lo spam)
# INVITES_SERVER_PER_DAY=400

# Licenza AGPL-3.0: link al codice sorgente mostrato in fondo a ogni pagina.
# Se hai modificato Tacuìn, metti qui il link alla tua versione (es. il tuo fork su GitHub).
# SOURCE_URL=https://github.com/Denzel18/tacuin

# Prezzi di borsa automatici dal codice ISIN (Yahoo Finance e OpenFIGI, gratuiti, senza chiave).
# Il server invia solo ISIN e simboli dei titoli. Si accendono e spengono anche da Impostazioni → Server (root).
# QUOTES=off
